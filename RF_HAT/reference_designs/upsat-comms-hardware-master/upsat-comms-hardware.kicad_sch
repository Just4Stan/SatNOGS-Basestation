	(text "CC1120/25 uning XTAL: do not mount: U6, C53, C65, R26, R24\nCC1120/25 using TCXO: do not mount: R27, R26, C67, U18, C69: mount 0 Ohm resistor\n X1: CC1120:32MHz and CC1125:40MHz\n R27 is a 0ohms shunt resistor that ground\n the EXT_XOSC pin when TCXO is not mounted.\n  "
		(exclude_from_sim no)
		(at 364.49 306.07 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
