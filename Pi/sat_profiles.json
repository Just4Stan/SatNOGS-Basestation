            "name_match": "AETHERSPACE",
            "norad_id": null,
            "freq_mhz": 433.0,
            "protocol": "native_cc1200",
            "rx_mode": "packet",
            "description": "AetherSpace CubeSat — CC1200 native packet mode, 2-GFSK 2.4 kbps"
        },

