# macOS
.DS_Store
**/.DS_Store

# KiCad lock files and auto-saves
*.lck
**/*.lck
_autosave-*
**/_autosave-*
~*.kicad_*

# KiCad footprint cache
fp-info-cache
**/fp-info-cache

# KiCad backup files
*.kicad_sch-bak
**/*.kicad_sch-bak
*.bak
**/*.bak
#auto_saved_files#
**/#auto_saved_files#

# KiCad auto-backups, ERC reports, local settings
**/*-backups/
**/*-erc.rpt
**/*.kicad_prl

# Claude Code
.claude/
CLAUDE.md

# Reference papers (not for public distribution)
Papers/

# Defense / presentation material and private prep notes (not for public repo)
*.pptx
docs/defense_evaluation_criteria.md

# Thesis - hide build artifacts, draft, and PDF
ThesisPaper/draft.md
ThesisPaper/thesis.pdf

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Build artifacts
**/build/
**/cmake-build-*/
**/.pio/
**/*.elf
**/*.map

# LaTeX build artifacts (also handled by ThesisPaper/.gitignore)
ThesisPaper/**/*.aux
ThesisPaper/**/*.bbl
ThesisPaper/**/*.bcf
ThesisPaper/**/*.blg
ThesisPaper/**/*.fdb_latexmk
ThesisPaper/**/*.fls
ThesisPaper/**/*.lof
ThesisPaper/**/*.log
ThesisPaper/**/*.lot
ThesisPaper/**/*.out
ThesisPaper/**/*.run.xml
ThesisPaper/**/*.synctex.gz
ThesisPaper/**/*.toc
ThesisPaper/**/*.xdv
ThesisPaper/**/*-SAVE-ERROR
# macOS Finder duplicates ("filename 2.pdf", "filename 2.png")
ThesisPaper/**/* [0-9].*

# Station credentials (API tokens, location)
station.conf
**/station.conf

# Keep only the latest compiled firmware at root
firmware-*.uf2
!firmware.uf2
# Captures, pass logs, and reception evidence — kept on disk only, never committed.
# These are the outputs of station.py, analyze_passes.py, and per-pass dumps.
# They can be large (~MB per pass) and contain potentially sensitive location data.
captures/
**/captures/
**/pass_logs/
captures/evidence/
# do NOT ignore ThesisPaper/images/figures/evidence/ — those are the thesis copies
*.raw
*.iq
pass_log_*.csv
# Stray root-level dated capture files (pattern: YYYYMMDD_HHMMSS_NAME.{raw,csv,json})
/20[0-9][0-9][0-9][0-9][0-9][0-9]_*.raw
/20[0-9][0-9][0-9][0-9][0-9][0-9]_*.csv
/20[0-9][0-9][0-9][0-9][0-9][0-9]_*.json
/Pi/20[0-9][0-9][0-9][0-9][0-9][0-9]_*.raw
/Pi/20[0-9][0-9][0-9][0-9][0-9][0-9]_*.csv
/Pi/20[0-9][0-9][0-9][0-9][0-9][0-9]_*.json

# VS Code / Local History extension snapshots (any directory)
**/.history/
.history/

# macOS Finder droppings
._*
**/._*

# Stray LaTeX stdin output
texput.log
