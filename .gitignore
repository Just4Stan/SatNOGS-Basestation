# macOS
.DS_Store
**/.DS_Store

# KiCad lock files and auto-saves
*.lck
**/*.lck
_autosave-*
**/_autosave-*
~*.kicad_*

# KiCad footprint cache
fp-info-cache
**/fp-info-cache

# KiCad backup files
*.kicad_sch-bak
**/*.kicad_sch-bak
*.bak
**/*.bak
#auto_saved_files#
**/#auto_saved_files#

# KiCad auto-backups, ERC reports, local settings
**/*-backups/
**/*-erc.rpt
**/*.kicad_prl

# Claude Code
.claude/
CLAUDE.md

# Reference papers (not for public distribution)
Papers/

# Thesis paper (private, not for public repo)
ThesisPaper/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Build artifacts
**/build/
**/cmake-build-*/
**/.pio/
**/*.elf
**/*.map

# LaTeX build artifacts (also handled by ThesisPaper/.gitignore)
ThesisPaper/**/*.aux
ThesisPaper/**/*.bbl
ThesisPaper/**/*.bcf
ThesisPaper/**/*.blg
ThesisPaper/**/*.fdb_latexmk
ThesisPaper/**/*.fls
ThesisPaper/**/*.lof
ThesisPaper/**/*.log
ThesisPaper/**/*.lot
ThesisPaper/**/*.out
ThesisPaper/**/*.run.xml
ThesisPaper/**/*.synctex.gz
ThesisPaper/**/*.toc
ThesisPaper/**/*.xdv
ThesisPaper/thesis.pdf

# Keep only the latest compiled firmware at root
firmware-*.uf2
!firmware.uf2
