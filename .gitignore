# macOS
.DS_Store
**/.DS_Store

# KiCad lock files and auto-saves
*.lck
**/*.lck
_autosave-*
**/_autosave-*
~*.kicad_*

# KiCad footprint cache
fp-info-cache
**/fp-info-cache

# KiCad backup files
*.kicad_sch-bak
**/*.kicad_sch-bak
*.bak
**/*.bak
#auto_saved_files#
**/#auto_saved_files#

# KiCad auto-backups, ERC reports, local settings
**/*-backups/
**/*-erc.rpt
**/*.kicad_prl

# Claude Code
.claude/
CLAUDE.md

# Thesis and reference papers (not for public distribution)
Papers/
ThesisPaper/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Build artifacts
**/build/
**/cmake-build-*/
**/.pio/
**/*.elf
**/*.map

# LaTeX build artifacts
ThesisPaper/**/*.aux
ThesisPaper/**/*.log
ThesisPaper/**/*.out
ThesisPaper/**/*.toc
ThesisPaper/**/*.bbl
ThesisPaper/**/*.blg
ThesisPaper/**/*.synctex.gz
ThesisPaper/**/*.fdb_latexmk
ThesisPaper/**/*.fls

# Keep only the latest compiled firmware at root
firmware-*.uf2
!firmware.uf2
